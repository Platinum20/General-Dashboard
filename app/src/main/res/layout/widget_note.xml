<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Nota" (2026-11-23, idea 8): una nota scelta, con le spunte da mettere col dito. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/note_w_header"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/note_w_title"
                style="@style/WidgetCardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="NOTA ›" />

            <TextView
                android:id="@+id/note_w_count"
                style="@style/WidgetSub"
                android:layout_marginEnd="12dp"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/note_w_open"
            style="@style/WidgetRoundButton"
            android:src="@drawable/widget_ic_edit"
            android:contentDescription="Scrivi nella nota" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/note_w_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
