<?xml version="1.0" encoding="utf-8"?>
<!-- Un giorno nel widget Calendario (1.528, come l'app): pallino sulla linea a sinistra, poi "Domani", "Mer 11". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="26dp">

        <ImageView
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_rail" />

        <ImageView
            android:id="@+id/day_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/day_text"
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/widget_text" />
</LinearLayout>
