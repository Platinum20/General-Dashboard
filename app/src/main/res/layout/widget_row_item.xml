<?xml version="1.0" encoding="utf-8"?>
<!-- Una cosa del calendario: cerchio da spuntare (promemoria) o segno colorato (evento, data), titolo e ora. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/item_check"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:src="@drawable/widget_check"
            android:contentDescription="Segna come fatto"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/item_mark"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/item_text"
        style="@style/WidgetText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp" />

    <TextView
        android:id="@+id/item_time"
        style="@style/WidgetSub"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:fontFamily="@font/inter_medium" />
</LinearLayout>
