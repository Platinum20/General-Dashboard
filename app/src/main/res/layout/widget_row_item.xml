<?xml version="1.0" encoding="utf-8"?>
<!-- Una cosa del calendario (1.528, come la riga dell'app): linea con il pallino colorato, ora a sinistra, titolo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="36dp">

        <ImageView
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_rail" />

        <ImageView
            android:id="@+id/item_mark"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/item_time"
        style="@style/WidgetSub"
        android:layout_width="44dp"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/inter_medium" />

    <TextView
        android:id="@+id/item_text"
        style="@style/WidgetText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp" />
</LinearLayout>
