<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Spese": solo il mese in corso (mai confronti con i mesi prima) e la spesa di oggi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/spend_label"
        style="@style/WidgetLabel"
        android:text="NOVEMBRE" />

    <TextView
        android:id="@+id/spend_total"
        style="@style/WidgetBig"
        android:layout_marginTop="6dp"
        android:text="0,00 €" />

    <TextView
        android:id="@+id/spend_sub"
        style="@style/WidgetSub"
        android:layout_marginTop="2dp"
        android:text="spesi questo mese" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            style="@style/WidgetSub"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Oggi" />

        <TextView
            android:id="@+id/spend_today"
            style="@style/WidgetText"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp"
            android:text="0,00 €" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/spend_balance_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            style="@style/WidgetSub"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Sul conto" />

        <TextView
            android:id="@+id/spend_balance"
            style="@style/WidgetText"
            android:fontFamily="@font/inter_semibold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
