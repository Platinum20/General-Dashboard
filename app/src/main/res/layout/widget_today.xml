<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Oggi": il blocco colorato col meteo e sotto le righe di Adesso. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/today_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_hero"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/today_date"
            style="@style/WidgetLabel"
            android:textColor="@color/widget_on_hero_secondary"
            android:text="LUNEDÌ 9 NOVEMBRE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_temp"
                style="@style/WidgetBig"
                android:textColor="@color/widget_on_hero"
                android:textSize="38sp"
                android:text="–" />

            <TextView
                android:id="@+id/today_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="26sp"
                android:text="☀️" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/today_place"
                    style="@style/WidgetText"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/widget_on_hero"
                    android:text="Canvas" />

                <TextView
                    android:id="@+id/today_desc"
                    style="@style/WidgetSub"
                    android:layout_width="match_parent"
                    android:textColor="@color/widget_on_hero_secondary"
                    android:text="Apri Canvas per il meteo" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="2dp" />
</LinearLayout>
