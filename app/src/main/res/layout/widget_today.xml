<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Oggi" (giro 2, 2026-11-21): come la card Adesso della Home. Il blocco colorato col meteo e le prossime ore,
  sotto una riga sola con la prossima cosa del calendario.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/today_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_hero"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/today_date"
            style="@style/WidgetLabel"
            android:textColor="@color/widget_on_hero_secondary"
            android:text="LUNEDÌ 9 · ROMA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_temp"
                style="@style/WidgetBig"
                android:textColor="@color/widget_on_hero"
                android:textSize="34sp"
                android:text="–" />

            <TextView
                android:id="@+id/today_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="22sp"
                android:text="☀️" />

            <TextView
                android:id="@+id/today_desc"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="@color/widget_on_hero"
                android:textSize="13sp"
                android:text="Apri Canvas per il meteo" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <LinearLayout
            android:id="@+id/today_hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_next"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/today_next_label"
            style="@style/WidgetLabel"
            android:text="PROSSIMO" />

        <TextView
            android:id="@+id/today_next_text"
            style="@style/WidgetText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
