<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Da fare" (giro 2, 2026-11-21): come la card della Home, le abitudini in cima e le cose da spuntare. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/todo_header"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <TextView
                style="@style/WidgetCardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="DA FARE ›" />

            <TextView
                android:id="@+id/todo_count"
                style="@style/WidgetSub"
                android:layout_marginEnd="12dp"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/todo_add"
            style="@style/WidgetRoundButton"
            android:src="@drawable/widget_ic_add"
            android:contentDescription="Aggiungi" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
