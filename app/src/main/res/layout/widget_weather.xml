<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Meteo": tutto blocco colorato, temperatura grande e le prossime ore. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hero_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_place"
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:textColor="@color/widget_on_hero_secondary"
        android:text="METEO" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_temp"
            style="@style/WidgetBig"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textColor="@color/widget_on_hero"
            android:textSize="44sp"
            android:text="–" />

        <TextView
            android:id="@+id/w_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:text="☀️" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_desc"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/widget_on_hero"
        android:textSize="13sp"
        android:text="Apri Canvas per il meteo" />

    <TextView
        android:id="@+id/w_range"
        style="@style/WidgetSub"
        android:layout_width="match_parent"
        android:textColor="@color/widget_on_hero_secondary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/w_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
