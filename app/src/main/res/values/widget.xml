<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nomi e descrizioni nell'elenco dei widget del telefono. -->
    <string name="widget_today_label">Oggi</string>
    <string name="widget_description">Il meteo e quello che conta adesso, come in cima alla Home</string>
    <string name="widget_calendar_label">Calendario</string>
    <string name="widget_tasks_description">Oggi e i prossimi giorni: eventi, promemoria da spuntare, date</string>
    <string name="widget_news_label">News</string>
    <string name="widget_news_description">Le storie nuove dall\'ultima visita</string>
    <string name="widget_sim_label">SIM</string>
    <string name="widget_sim_description">Giga rimasti e rinnovo della SIM</string>
    <string name="widget_weather_label">Meteo</string>
    <string name="widget_weather_description">Temperatura adesso e le prossime ore</string>
    <string name="widget_capture_label">Scrivi</string>
    <string name="widget_capture_description">Scrivi o detta al volo: Canvas capisce da solo cos\'è</string>

    <dimen name="widget_radius">24dp</dimen>
    <dimen name="widget_inner_radius">16dp</dimen>

    <!-- L'etichetta maiuscola sopra un blocco, come SectionHeader nell'app. -->
    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Il numero grande: temperatura, euro, giga. -->
    <style name="WidgetBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_display_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetSub" parent="WidgetText">
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Il tasto tondo pieno in alto a destra o accanto al campo. -->
    <style name="WidgetRoundButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/widget_round_accent</item>
    </style>
</resources>
