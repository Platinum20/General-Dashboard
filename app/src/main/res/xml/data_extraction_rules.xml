<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico di Android 12 e successivi, e passaggio a un telefono nuovo: stessi file. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="notes.json" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="weather.xml" />
        <include domain="sharedpref" path="backup.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="notes.json" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="sharedpref" path="weather.xml" />
        <include domain="sharedpref" path="backup.xml" />
    </device-transfer>
</data-extraction-rules>
